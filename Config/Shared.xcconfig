// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = RunConvert
PRODUCT_DISPLAY_NAME = RunConvert
PRODUCT_BUNDLE_IDENTIFIER = com.aisolo.runconvert
MARKETING_VERSION = 1.0.2
CURRENT_PROJECT_VERSION = 3
DEVELOPMENT_TEAM = GQF7RG5Z88

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = portrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = portrait

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/RunningAppConverter.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/RunningAppConverter.entitlements

// Public release metadata. No encryption APIs or networking are used.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
